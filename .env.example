# ==========================================
# Evently Application Configuration
# ==========================================

# Application
PROJECT_NAME="Evently"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="127.0.0.1"
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_password_here"
POSTGRES_DB="evently_dev"

# Database Connection URLs
# Async URL for FastAPI application (SQLAlchemy async engine via asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:your_password_here@localhost:5432/evently_dev"

# Sync URL for Alembic migrations (SQLAlchemy sync engine via psycopg)
DATABASE_URL_SYNC="postgresql+psycopg://postgres:your_password_here@localhost:5432/evently_dev"

# Test Database Connection URLs
TEST_DATABASE_URL="postgresql+asyncpg://postgres:your_password_here@localhost:5432/evently_test"
TEST_DATABASE_URL_SYNC="postgresql+psycopg://postgres:your_password_here@localhost:5432/evently_test"

# Security & JWT Configuration
SECRET_KEY="generate_a_random_secret_key_using_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
